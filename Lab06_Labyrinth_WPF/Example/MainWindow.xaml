<Window x:Class="Example.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Example"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800"
        KeyDown="Window_KeyDown">
    <StackPanel Orientation="Horizontal">
        <Button Content="Click Me" Width="100" Height="30" HorizontalAlignment="Center" Margin="10"/>
        <Button Content="Click Me" Width="100" Height="30" HorizontalAlignment="Center" Margin="10"/>

        <StackPanel Orientation="Vertical">
            <Button Content="Click Me" Width="100" Height="30" HorizontalAlignment="Center" Margin="10"/>
            <Button Content="Click Me" Width="100" Height="30" HorizontalAlignment="Center" Margin="10"/>
        </StackPanel>

        <Canvas x:Name="Spielfeld" Background="BlueViolet" Width="200" Height="400">
            <Canvas Background="HotPink" Width="100" Height="100" Canvas.Left="50" Canvas.Top="50"/>
            
        </Canvas>
 
    </StackPanel>
</Window>
